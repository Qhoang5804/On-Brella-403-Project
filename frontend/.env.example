# Frontend Environment Variables
# Copy this file to .env if you need to override defaults
# Note: Vite requires the VITE_ prefix for environment variables

# Backend API URL (optional)
# Defaults to http://localhost:5001 in development mode
# Leave empty or unset to use defaults
VITE_API_URL=http://localhost:5001

# Supabase project URL (from Project Settings → API)
VITE_SUPABASE_URL=your-project-url

# Supabase public anon key (NOT the service_role key)
VITE_SUPABASE_PUBLISHABLE_KEY=your-public-anon-key-here